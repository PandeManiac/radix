{
  "format": "radix-project",
  "version": 13,
  "name": "Ternary inverter switching",
  "root": "main",
  "domains": [
    {
      "id": "binary",
      "name": "Binary",
      "values": ["0", "1"],
      "drivers": { "kind": "single" }
    }
  ],
  "definitions": [
    {
      "id": "main",
      "name": "Main",
      "pins": [],
      "instances": [],
      "nets": [],
      "ports": []
    }
  ],
  "electricalCircuits": [
    {
      "id": "ternary-switch",
      "name": "Ternary inverter, 0 V to mid-rail",
      "description": "The dual-threshold ternary inverter driven from 0 V to 2.5 V: the output leaves the 5 V rail and settles on the middle level. Two time constants are in the path: the drive must first charge the gate bus through the 10 kOhm gate resistor, then the summing node charges the devices' own drain capacitance through the 50 kOhm Thevenin resistance. Each device also has 0.02 pF from gate to drain, so a moving output feeds back into the gate bus through that path.",
      "ground": "gnd",
      "nodes": [
        { "id": "gnd", "name": "Ground" },
        { "id": "vdd", "name": "5 V rail" },
        { "id": "in", "name": "Input" },
        { "id": "g", "name": "Shared gate bus" },
        { "id": "out_low", "name": "Low-threshold inverter output" },
        { "id": "out_high", "name": "High-threshold inverter output" },
        { "id": "out", "name": "Summed output" }
      ],
      "components": [
        {
          "id": "VDD",
          "name": "Rail",
          "kind": "voltage-source",
          "value": 5,
          "terminals": [
            { "id": "a", "name": "Positive", "polarity": "positive", "node": "vdd" },
            { "id": "b", "name": "Negative", "polarity": "negative", "node": "gnd" }
          ]
        },
        {
          "id": "VIN",
          "name": "Input drive",
          "kind": "voltage-source",
          "value": 0,
          "waveform": [
            { "time": 0, "value": 0 },
            { "time": 20e-9, "value": 0 },
            { "time": 21e-9, "value": 2.5 }
          ],
          "terminals": [
            { "id": "a", "name": "Positive", "polarity": "positive", "node": "in" },
            { "id": "b", "name": "Negative", "polarity": "negative", "node": "gnd" }
          ]
        },
        {
          "id": "RG",
          "name": "Gate drive resistor",
          "kind": "resistor",
          "value": 10000,
          "terminals": [
            { "id": "a", "name": "A", "polarity": "passive", "node": "in" },
            { "id": "b", "name": "B", "polarity": "passive", "node": "g" }
          ]
        },
        {
          "id": "MPL",
          "name": "Weak p-channel pull-up",
          "kind": "mosfet",
          "value": 1e-05,
          "channel": "p",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 0.25e-12,
          "gateDrainCapacitance": 0.02e-12,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            { "id": "drain", "name": "Drain", "polarity": "passive", "node": "out_low" },
            { "id": "gate", "name": "Gate", "polarity": "passive", "node": "g" },
            { "id": "source", "name": "Source", "polarity": "passive", "node": "vdd" }
          ]
        },
        {
          "id": "MNL",
          "name": "Strong n-channel pull-down",
          "kind": "mosfet",
          "value": 0.00121,
          "channel": "n",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 0.25e-12,
          "gateDrainCapacitance": 0.02e-12,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            { "id": "drain", "name": "Drain", "polarity": "passive", "node": "out_low" },
            { "id": "gate", "name": "Gate", "polarity": "passive", "node": "g" },
            { "id": "source", "name": "Source", "polarity": "passive", "node": "gnd" }
          ]
        },
        {
          "id": "MPH",
          "name": "Strong p-channel pull-up",
          "kind": "mosfet",
          "value": 0.00121,
          "channel": "p",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 0.25e-12,
          "gateDrainCapacitance": 0.02e-12,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            { "id": "drain", "name": "Drain", "polarity": "passive", "node": "out_high" },
            { "id": "gate", "name": "Gate", "polarity": "passive", "node": "g" },
            { "id": "source", "name": "Source", "polarity": "passive", "node": "vdd" }
          ]
        },
        {
          "id": "MNH",
          "name": "Weak n-channel pull-down",
          "kind": "mosfet",
          "value": 1e-05,
          "channel": "n",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 0.25e-12,
          "gateDrainCapacitance": 0.02e-12,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            { "id": "drain", "name": "Drain", "polarity": "passive", "node": "out_high" },
            { "id": "gate", "name": "Gate", "polarity": "passive", "node": "g" },
            { "id": "source", "name": "Source", "polarity": "passive", "node": "gnd" }
          ]
        },
        {
          "id": "RSUM1",
          "name": "Summing resistor",
          "kind": "resistor",
          "value": 100000,
          "terminals": [
            { "id": "a", "name": "A", "polarity": "passive", "node": "out_low" },
            { "id": "b", "name": "B", "polarity": "passive", "node": "out" }
          ]
        },
        {
          "id": "RSUM2",
          "name": "Summing resistor",
          "kind": "resistor",
          "value": 100000,
          "terminals": [
            { "id": "a", "name": "A", "polarity": "passive", "node": "out_high" },
            { "id": "b", "name": "B", "polarity": "passive", "node": "out" }
          ]
        }
      ]
    }
  ]
}
