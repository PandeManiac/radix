{
  "format": "radix-dc-netlist",
  "version": 1,
  "ground": "gnd",
  "elements": [
    {
      "id": "V1",
      "type": "voltage-source",
      "nodeA": "in",
      "nodeB": "gnd",
      "volts": 5
    },
    {
      "id": "R1",
      "type": "resistor",
      "nodeA": "in",
      "nodeB": "out",
      "ohms": 1000
    },
    {
      "id": "D1",
      "type": "diode",
      "nodeA": "out",
      "nodeB": "gnd",
      "saturationCurrent": 1e-12,
      "emissionCoefficient": 1,
      "thermalVoltage": 0.025852,
      "seriesResistance": 10
    }
  ]
}
