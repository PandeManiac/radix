{
  "format": "radix-test",
  "version": 1,
  "name": "Tiny CPU pushes, pops, calls, and returns",
  "description": "Stores 5 at RAM[8], pushes and pops 9, calls a subroutine that loads RAM[8] directly, adds RAM[9] indirectly, then returns through the stack to the halt loop.",
  "definition": "demo.tiny-cpu",
  "steps": [
    { "at": 0, "set": { "clk": 0, "reset": 0 } },
    {
      "at": 20,
      "expect": { "carry": 0, "zero": 1 },
      "expectLane": { "pc": 0, "sp": 0, "acc": 0, "mem": 0, "instruction": 21, "opcode": 1, "operand": 5 }
    },
    { "at": 30, "set": { "clk": 1 } },
    {
      "at": 80,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 1, "sp": 0, "acc": 5, "mem": 0, "instruction": 56, "opcode": 3, "operand": 8 }
    },
    { "at": 90, "set": { "clk": 0 } },
    { "at": 130, "set": { "clk": 1 } },
    {
      "at": 180,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 2, "sp": 0, "acc": 5, "mem": 0, "instruction": 25, "opcode": 1, "operand": 9 }
    },
    { "at": 190, "set": { "clk": 0 } },
    { "at": 230, "set": { "clk": 1 } },
    {
      "at": 280,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 3, "sp": 0, "acc": 9, "mem": 0, "instruction": 160, "opcode": 10, "operand": 0 }
    },
    { "at": 290, "set": { "clk": 0 } },
    { "at": 330, "set": { "clk": 1 } },
    {
      "at": 380,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 4, "sp": 1, "acc": 9, "mem": 9, "instruction": 16, "opcode": 1, "operand": 0 }
    },
    { "at": 390, "set": { "clk": 0 } },
    { "at": 430, "set": { "clk": 1 } },
    {
      "at": 480,
      "expect": { "carry": 0, "zero": 1 },
      "expectLane": { "pc": 5, "sp": 1, "acc": 0, "mem": 9, "instruction": 176, "opcode": 11, "operand": 0 }
    },
    { "at": 490, "set": { "clk": 0 } },
    { "at": 530, "set": { "clk": 1 } },
    {
      "at": 580,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 6, "sp": 0, "acc": 9, "mem": 0, "instruction": 57, "opcode": 3, "operand": 9 }
    },
    { "at": 590, "set": { "clk": 0 } },
    { "at": 630, "set": { "clk": 1 } },
    {
      "at": 680,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 7, "sp": 0, "acc": 9, "mem": 9, "instruction": 204, "opcode": 12, "operand": 12 }
    },
    { "at": 690, "set": { "clk": 0 } },
    { "at": 730, "set": { "clk": 1 } },
    {
      "at": 780,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 12, "sp": 1, "acc": 9, "mem": 5, "instruction": 232, "opcode": 14, "operand": 8 }
    },
    { "at": 790, "set": { "clk": 0 } },
    { "at": 830, "set": { "clk": 1 } },
    {
      "at": 880,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 13, "sp": 1, "acc": 5, "mem": 9, "instruction": 153, "opcode": 9, "operand": 9 }
    },
    { "at": 890, "set": { "clk": 0 } },
    { "at": 930, "set": { "clk": 1 } },
    {
      "at": 980,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 14, "sp": 1, "acc": 14, "mem": 8, "instruction": 208, "opcode": 13, "operand": 0 }
    },
    { "at": 990, "set": { "clk": 0 } },
    { "at": 1030, "set": { "clk": 1 } },
    {
      "at": 1080,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 8, "sp": 0, "acc": 14, "mem": 5, "instruction": 104, "opcode": 6, "operand": 8 }
    },
    { "at": 1090, "set": { "clk": 0 } },
    { "at": 1130, "set": { "clk": 1 } },
    {
      "at": 1180,
      "expect": { "carry": 0, "zero": 0 },
      "expectLane": { "pc": 8, "sp": 0, "acc": 14, "mem": 5, "instruction": 104, "opcode": 6, "operand": 8 }
    }
  ]
}
