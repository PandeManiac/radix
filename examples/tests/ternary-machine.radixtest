{
  "format": "radix-test",
  "version": 1,
  "name": "Ternary program machine runs its 9-instruction lookup program",
  "description": "Nine ternary instructions loop: LOAD 1, ADD 2, ADD 2, NOP, LOAD 2, ADD 2, ADD 1, NOP, NOP. PC wraps from 8 to 0.",
  "definition": "demo.t-machine",
  "steps": [
    { "at": 0, "set": { "clk": 0 } },
    {
      "at": 60,
      "expectLane": { "pc": 0, "acc": 0, "opcode": 1, "operand": 1 },
      "description": "reset state fetches LOAD 1"
    },
    { "at": 80, "set": { "clk": 0 } },
    { "at": 160, "set": { "clk": 2 } },
    { "at": 280, "expectLane": { "pc": 1, "acc": 1, "opcode": 2, "operand": 2 } },
    { "at": 300, "set": { "clk": 0 } },
    { "at": 380, "set": { "clk": 2 } },
    { "at": 500, "expectLane": { "pc": 2, "acc": 3, "opcode": 2, "operand": 2 } },
    { "at": 520, "set": { "clk": 0 } },
    { "at": 600, "set": { "clk": 2 } },
    { "at": 720, "expectLane": { "pc": 3, "acc": 5, "opcode": 0, "operand": 0 } },
    { "at": 740, "set": { "clk": 0 } },
    { "at": 820, "set": { "clk": 2 } },
    { "at": 940, "expectLane": { "pc": 4, "acc": 5, "opcode": 1, "operand": 2 } },
    { "at": 960, "set": { "clk": 0 } },
    { "at": 1040, "set": { "clk": 2 } },
    { "at": 1160, "expectLane": { "pc": 5, "acc": 2, "opcode": 2, "operand": 2 } },
    { "at": 1180, "set": { "clk": 0 } },
    { "at": 1260, "set": { "clk": 2 } },
    { "at": 1380, "expectLane": { "pc": 6, "acc": 4, "opcode": 2, "operand": 1 } },
    { "at": 1400, "set": { "clk": 0 } },
    { "at": 1480, "set": { "clk": 2 } },
    { "at": 1600, "expectLane": { "pc": 7, "acc": 5, "opcode": 0, "operand": 0 } },
    { "at": 1620, "set": { "clk": 0 } },
    { "at": 1700, "set": { "clk": 2 } },
    { "at": 1820, "expectLane": { "pc": 8, "acc": 5, "opcode": 0, "operand": 0 } },
    { "at": 1840, "set": { "clk": 0 } },
    { "at": 1920, "set": { "clk": 2 } },
    { "at": 2040, "expectLane": { "pc": 0, "acc": 5, "opcode": 1, "operand": 1 }, "description": "PC wraps to 0" },
    { "at": 2060, "set": { "clk": 0 } },
    { "at": 2140, "set": { "clk": 2 } },
    { "at": 2260, "expectLane": { "pc": 1, "acc": 1 }, "description": "program restarts with LOAD 1" }
  ]
}
