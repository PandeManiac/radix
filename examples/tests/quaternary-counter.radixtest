{
  "format": "radix-test",
  "version": 1,
  "name": "Quaternary counter advances 0..15 and wraps",
  "description": "Each rising edge (CLK 0 -> 3) samples the next radix-4 digit pair; the Count lane decodes D0 + 4*D1.",
  "definition": "demo.q4-counter",
  "steps": [
    { "at": 0, "set": { "clk": 0 } },
    { "at": 20, "expect": { "q0": 0, "q1": 0 }, "expectLane": { "count": 0 } },
    { "at": 30, "set": { "clk": 3 } },
    { "at": 60, "expect": { "q0": 1, "q1": 0 }, "expectLane": { "count": 1 } },
    { "at": 70, "set": { "clk": 0 } },
    { "at": 100, "expectLane": { "count": 1 } },
    { "at": 110, "set": { "clk": 3 } },
    { "at": 140, "expectLane": { "count": 2 } },
    { "at": 150, "set": { "clk": 0 } },
    { "at": 190, "set": { "clk": 3 } },
    { "at": 220, "expect": { "q0": 3, "q1": 0 }, "expectLane": { "count": 3 } },
    { "at": 230, "set": { "clk": 0 } },
    {
      "at": 270,
      "set": { "clk": 3 },
      "edges": {
        "ticks": 40,
        "expect": {
          "clk": [ { "from": 0, "to": 3, "count": 1 } ],
          "q0": [ { "from": 3, "to": 0, "count": 1 } ],
          "q1": [ { "from": 0, "to": 1, "count": 1 } ]
        }
      },
      "description": "the first carry changes both radix-4 digits exactly once"
    },
    { "at": 310, "expect": { "q0": 0, "q1": 1 }, "expectLane": { "count": 4 } },
    { "at": 320, "set": { "clk": 0 } },
    { "at": 360, "set": { "clk": 3 } },
    { "at": 390, "expectLane": { "count": 5 } },
    { "at": 400, "set": { "clk": 0 } },
    { "at": 440, "set": { "clk": 3 } },
    { "at": 470, "expectLane": { "count": 6 } },
    { "at": 480, "set": { "clk": 0 } },
    { "at": 520, "set": { "clk": 3 } },
    { "at": 550, "expectLane": { "count": 7 } },
    { "at": 560, "set": { "clk": 0 } },
    { "at": 600, "set": { "clk": 3 } },
    { "at": 630, "expectLane": { "count": 8 } },
    { "at": 640, "set": { "clk": 0 } },
    { "at": 680, "set": { "clk": 3 } },
    { "at": 710, "expectLane": { "count": 9 } },
    { "at": 720, "set": { "clk": 0 } },
    { "at": 760, "set": { "clk": 3 } },
    { "at": 790, "expectLane": { "count": 10 } },
    { "at": 800, "set": { "clk": 0 } },
    { "at": 840, "set": { "clk": 3 } },
    { "at": 870, "expectLane": { "count": 11 } },
    { "at": 880, "set": { "clk": 0 } },
    { "at": 920, "set": { "clk": 3 } },
    { "at": 950, "expectLane": { "count": 12 } },
    { "at": 960, "set": { "clk": 0 } },
    { "at": 1000, "set": { "clk": 3 } },
    { "at": 1030, "expectLane": { "count": 13 } },
    { "at": 1040, "set": { "clk": 0 } },
    { "at": 1080, "set": { "clk": 3 } },
    { "at": 1110, "expectLane": { "count": 14 } },
    { "at": 1120, "set": { "clk": 0 } },
    { "at": 1160, "set": { "clk": 3 } },
    { "at": 1190, "expectLane": { "count": 15 } },
    { "at": 1200, "set": { "clk": 0 } },
    {
      "at": 1240,
      "set": { "clk": 3 },
      "transitions": { "ticks": 40, "expect": { "clk": 1, "q0": 1, "q1": 1 } },
      "description": "the wrap edge changes both radix-4 digits exactly once"
    },
    { "at": 1280, "expect": { "q0": 0, "q1": 0 }, "expectLane": { "count": 0 }, "description": "wraps after the sixteenth state" }
  ]
}
