{
  "format": "radix-test",
  "version": 1,
  "name": "Ternary counter advances 0..8 and wraps",
  "description": "Each rising edge (CLK 0 -> 2) samples the next trit pair; the Count lane decodes T0 + 3*T1.",
  "definition": "demo.ternary-counter",
  "steps": [
    { "at": 0, "set": { "clk": 0 } },
    { "at": 20, "expect": { "t0": 0, "t1": 0 }, "expectLane": { "count": 0 } },
    { "at": 30, "set": { "clk": 2 } },
    { "at": 60, "expect": { "t0": 1, "t1": 0 }, "expectLane": { "count": 1 } },
    { "at": 70, "set": { "clk": 0 } },
    { "at": 110, "set": { "clk": 2 } },
    { "at": 140, "expect": { "t0": 2, "t1": 0 }, "expectLane": { "count": 2 } },
    { "at": 150, "set": { "clk": 0 } },
    {
      "at": 190,
      "set": { "clk": 2 },
      "edges": {
        "ticks": 30,
        "expect": {
          "clk": [ { "from": 0, "to": 2, "count": 1 } ],
          "t0": [ { "from": 2, "to": 0, "count": 1 }, { "from": 0, "to": 2, "count": 0 } ],
          "t1": [ { "from": 0, "to": 1, "count": 1 }, { "from": 1, "to": 0, "count": 0 } ]
        }
      },
      "description": "only the rising CLK edge, the low-trit wrap, and the carry into T1 are observed"
    },
    { "at": 220, "expectLane": { "count": 3 }, "description": "low trit wraps to 0 and carries into T1" },
    { "at": 230, "set": { "clk": 0 } },
    { "at": 270, "set": { "clk": 2 } },
    { "at": 300, "expectLane": { "count": 4 } },
    { "at": 310, "set": { "clk": 0 } },
    { "at": 350, "set": { "clk": 2 } },
    { "at": 380, "expectLane": { "count": 5 } },
    { "at": 390, "set": { "clk": 0 } },
    { "at": 430, "set": { "clk": 2 } },
    { "at": 460, "expectLane": { "count": 6 } },
    { "at": 470, "set": { "clk": 0 } },
    { "at": 510, "set": { "clk": 2 } },
    { "at": 540, "expectLane": { "count": 7 } },
    { "at": 550, "set": { "clk": 0 } },
    { "at": 590, "set": { "clk": 2 } },
    { "at": 620, "expect": { "t0": 2, "t1": 2 }, "expectLane": { "count": 8 } },
    { "at": 630, "set": { "clk": 0 } },
    {
      "at": 670,
      "set": { "clk": 2 },
      "transitions": { "ticks": 30, "expect": { "clk": 1, "t0": 1, "t1": 1 } },
      "description": "the wrap edge changes both trits exactly once"
    },
    { "at": 700, "expect": { "t0": 0, "t1": 0 }, "expectLane": { "count": 0 }, "description": "wraps after the ninth state" }
  ]
}
