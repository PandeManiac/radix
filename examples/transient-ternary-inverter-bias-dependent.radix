{
  "format": "radix-project",
  "version": 15,
  "name": "Ternary inverter switching, bias-dependent gate charge",
  "root": "main",
  "domains": [
    {
      "id": "binary",
      "name": "Binary",
      "values": [
        "0",
        "1"
      ],
      "drivers": {
        "kind": "single"
      }
    }
  ],
  "definitions": [
    {
      "id": "main",
      "name": "Main",
      "pins": [],
      "instances": [],
      "nets": [],
      "ports": []
    }
  ],
  "electricalCircuits": [
    {
      "id": "ternary-switch",
      "name": "Ternary inverter, 0 V to mid-rail, bias-dependent gate charge",
      "description": "The same dual-threshold ternary inverter with every MOSFET authored to re-evaluate its gate capacitance from the region it is solved in: two thirds of cgs and no cgd while saturated. Transient-ternary-inverter.radix holds the authored values for the whole run, so the two files differ only in that choice; the gate bus settles sooner here and the output no longer overshoots the rail.",
      "ground": "gnd",
      "nodes": [
        {
          "id": "gnd",
          "name": "Ground"
        },
        {
          "id": "vdd",
          "name": "5 V rail"
        },
        {
          "id": "in",
          "name": "Input"
        },
        {
          "id": "g",
          "name": "Shared gate bus"
        },
        {
          "id": "out_low",
          "name": "Low-threshold inverter output"
        },
        {
          "id": "out_high",
          "name": "High-threshold inverter output"
        },
        {
          "id": "out",
          "name": "Summed output"
        }
      ],
      "components": [
        {
          "id": "VDD",
          "name": "Rail",
          "kind": "voltage-source",
          "value": 5,
          "terminals": [
            {
              "id": "a",
              "name": "Positive",
              "polarity": "positive",
              "node": "vdd"
            },
            {
              "id": "b",
              "name": "Negative",
              "polarity": "negative",
              "node": "gnd"
            }
          ]
        },
        {
          "id": "VIN",
          "name": "Input drive",
          "kind": "voltage-source",
          "value": 0,
          "waveform": [
            {
              "time": 0,
              "value": 0
            },
            {
              "time": 2e-08,
              "value": 0
            },
            {
              "time": 2.1e-08,
              "value": 2.5
            }
          ],
          "terminals": [
            {
              "id": "a",
              "name": "Positive",
              "polarity": "positive",
              "node": "in"
            },
            {
              "id": "b",
              "name": "Negative",
              "polarity": "negative",
              "node": "gnd"
            }
          ]
        },
        {
          "id": "RG",
          "name": "Gate drive resistor",
          "kind": "resistor",
          "value": 10000,
          "terminals": [
            {
              "id": "a",
              "name": "A",
              "polarity": "passive",
              "node": "in"
            },
            {
              "id": "b",
              "name": "B",
              "polarity": "passive",
              "node": "g"
            }
          ]
        },
        {
          "id": "MPL",
          "name": "Weak p-channel pull-up",
          "kind": "mosfet",
          "value": 1e-05,
          "channel": "p",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 2.5e-13,
          "gateDrainCapacitance": 2e-14,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            {
              "id": "drain",
              "name": "Drain",
              "polarity": "passive",
              "node": "out_low"
            },
            {
              "id": "gate",
              "name": "Gate",
              "polarity": "passive",
              "node": "g"
            },
            {
              "id": "source",
              "name": "Source",
              "polarity": "passive",
              "node": "vdd"
            }
          ],
          "biasDependentCapacitance": true
        },
        {
          "id": "MNL",
          "name": "Strong n-channel pull-down",
          "kind": "mosfet",
          "value": 0.00121,
          "channel": "n",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 2.5e-13,
          "gateDrainCapacitance": 2e-14,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            {
              "id": "drain",
              "name": "Drain",
              "polarity": "passive",
              "node": "out_low"
            },
            {
              "id": "gate",
              "name": "Gate",
              "polarity": "passive",
              "node": "g"
            },
            {
              "id": "source",
              "name": "Source",
              "polarity": "passive",
              "node": "gnd"
            }
          ],
          "biasDependentCapacitance": true
        },
        {
          "id": "MPH",
          "name": "Strong p-channel pull-up",
          "kind": "mosfet",
          "value": 0.00121,
          "channel": "p",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 2.5e-13,
          "gateDrainCapacitance": 2e-14,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            {
              "id": "drain",
              "name": "Drain",
              "polarity": "passive",
              "node": "out_high"
            },
            {
              "id": "gate",
              "name": "Gate",
              "polarity": "passive",
              "node": "g"
            },
            {
              "id": "source",
              "name": "Source",
              "polarity": "passive",
              "node": "vdd"
            }
          ],
          "biasDependentCapacitance": true
        },
        {
          "id": "MNH",
          "name": "Weak n-channel pull-down",
          "kind": "mosfet",
          "value": 1e-05,
          "channel": "n",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 2.5e-13,
          "gateDrainCapacitance": 2e-14,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            {
              "id": "drain",
              "name": "Drain",
              "polarity": "passive",
              "node": "out_high"
            },
            {
              "id": "gate",
              "name": "Gate",
              "polarity": "passive",
              "node": "g"
            },
            {
              "id": "source",
              "name": "Source",
              "polarity": "passive",
              "node": "gnd"
            }
          ],
          "biasDependentCapacitance": true
        },
        {
          "id": "RSUM1",
          "name": "Summing resistor",
          "kind": "resistor",
          "value": 100000,
          "terminals": [
            {
              "id": "a",
              "name": "A",
              "polarity": "passive",
              "node": "out_low"
            },
            {
              "id": "b",
              "name": "B",
              "polarity": "passive",
              "node": "out"
            }
          ]
        },
        {
          "id": "RSUM2",
          "name": "Summing resistor",
          "kind": "resistor",
          "value": 100000,
          "terminals": [
            {
              "id": "a",
              "name": "A",
              "polarity": "passive",
              "node": "out_high"
            },
            {
              "id": "b",
              "name": "B",
              "polarity": "passive",
              "node": "out"
            }
          ]
        }
      ]
    }
  ]
}
