{
  "format": "radix-project",
  "version": 21,
  "name": "Electrical ternary inverter chain",
  "root": "demo.chain",
  "settings": {
    "maxEvaluationsPerComponentPerTimestamp": 64,
    "maxPendingEvents": 1000000,
    "maxRecordedNetChanges": 500000,
    "defaultAdvanceTicks": 10,
    "traceAllNets": true
  },
  "domains": [
    {
      "id": "binary",
      "name": "Binary",
      "values": [
        "0",
        "1"
      ],
      "drivers": {
        "kind": "single"
      },
      "description": "Two-state domain. Values are indices; two's-complement and other interpretations live outside the kernel."
    },
    {
      "id": "ternary",
      "name": "Ternary",
      "values": [
        "0",
        "1",
        "2"
      ],
      "drivers": {
        "kind": "single"
      },
      "description": "Three-state domain. No balanced or positional interpretation is implied."
    },
    {
      "id": "quaternary",
      "name": "Quaternary",
      "values": [
        "0",
        "1",
        "2",
        "3"
      ],
      "drivers": {
        "kind": "single"
      },
      "description": "Four-state digit domain with no implied arithmetic. Unsigned radix-4 interpretation lives in the numeric format catalog."
    },
    {
      "id": "balanced-ternary",
      "name": "Balanced ternary",
      "values": [
        "-",
        "0",
        "+"
      ],
      "drivers": {
        "kind": "single"
      },
      "description": "Three-state domain whose labels suggest balanced ternary. The kernel still treats them as ordinals."
    },
    {
      "id": "four-state",
      "name": "Four-state logic",
      "values": [
        "0",
        "1",
        "X",
        "Z"
      ],
      "drivers": {
        "kind": "priority",
        "priorities": [
          1,
          1,
          3,
          0
        ],
        "conflictValue": 2
      },
      "description": "Four-state domain with high impedance (Z) and unknown/conflict (X)."
    }
  ],
  "definitions": [
    {
      "id": "demo.chain",
      "name": "Ternary inverter chain",
      "pins": [
        {
          "id": "a",
          "name": "A",
          "direction": "input",
          "domain": "ternary"
        },
        {
          "id": "y",
          "name": "Y",
          "direction": "output",
          "domain": "ternary",
          "externalSupply": true
        }
      ],
      "instances": [
        {
          "id": "first",
          "primitive": {
            "kind": "lookup",
            "inputCount": 1,
            "table": [
              2,
              1,
              0
            ],
            "delay": 0
          },
          "x": 0,
          "y": 0
        },
        {
          "id": "second",
          "primitive": {
            "kind": "lookup",
            "inputCount": 1,
            "table": [
              2,
              1,
              0
            ],
            "delay": 0
          },
          "x": 160,
          "y": 0
        }
      ],
      "nets": [
        {
          "id": "a_net",
          "domain": "ternary",
          "pins": [
            {
              "instance": "first",
              "pin": "in0"
            }
          ]
        },
        {
          "id": "m_net",
          "domain": "ternary",
          "pins": [
            {
              "instance": "first",
              "pin": "out"
            },
            {
              "instance": "second",
              "pin": "in0"
            }
          ]
        },
        {
          "id": "y_net",
          "domain": "ternary",
          "pins": [
            {
              "instance": "second",
              "pin": "out"
            }
          ]
        }
      ],
      "ports": [
        {
          "pin": "a",
          "net": "a_net"
        },
        {
          "pin": "y",
          "net": "y_net"
        }
      ]
    }
  ],
  "electricalCircuits": [
    {
      "id": "chain",
      "name": "Two-stage ternary inverter",
      "description": "The swept inverter duplicated and cascaded. Stage two is driven from stage one output through a 10 kOhm gate resistor, so stage one works into the second gate bus rather than an open node. Each plateau is long enough for both stages to settle; the second output should follow the input through two inversions, level 0 then 1 then 2, arriving several times later than one stage alone.",
      "ground": "gnd",
      "driveBindings": [
        {
          "node": "in",
          "pin": "a",
          "ticksPerSecond": 1000000000
        },
        {
          "node": "out2",
          "pin": "y",
          "ticksPerSecond": 1000000000
        }
      ],
      "nodes": [
        {
          "id": "gnd",
          "name": "Ground"
        },
        {
          "id": "vdd",
          "name": "5 V rail"
        },
        {
          "id": "in",
          "name": "Input"
        },
        {
          "id": "g1",
          "name": "Stage 1 gate bus"
        },
        {
          "id": "out_low1",
          "name": "Stage 1 low-threshold output"
        },
        {
          "id": "out_high1",
          "name": "Stage 1 high-threshold output"
        },
        {
          "id": "out1",
          "name": "Stage 1 output"
        },
        {
          "id": "g2",
          "name": "Stage 2 gate bus"
        },
        {
          "id": "out_low2",
          "name": "Stage 2 low-threshold output"
        },
        {
          "id": "out_high2",
          "name": "Stage 2 high-threshold output"
        },
        {
          "id": "out2",
          "name": "Stage 2 output"
        }
      ],
      "components": [
        {
          "id": "VDD",
          "name": "Rail",
          "kind": "voltage-source",
          "value": 5,
          "terminals": [
            {
              "id": "a",
              "name": "Positive",
              "polarity": "positive",
              "node": "vdd"
            },
            {
              "id": "b",
              "name": "Negative",
              "polarity": "negative",
              "node": "gnd"
            }
          ]
        },
        {
          "id": "VIN",
          "name": "Input drive",
          "kind": "voltage-source",
          "value": 0,
          "waveform": [
            {
              "time": 0,
              "value": 0
            },
            {
              "time": 2e-08,
              "value": 0
            },
            {
              "time": 2.1e-08,
              "value": 2.5
            },
            {
              "time": 2e-07,
              "value": 2.5
            },
            {
              "time": 2.01e-07,
              "value": 5
            }
          ],
          "terminals": [
            {
              "id": "a",
              "name": "Positive",
              "polarity": "positive",
              "node": "in"
            },
            {
              "id": "b",
              "name": "Negative",
              "polarity": "negative",
              "node": "gnd"
            }
          ]
        },
        {
          "id": "RG",
          "name": "Gate drive resistor",
          "kind": "resistor",
          "value": 10000,
          "terminals": [
            {
              "id": "a",
              "name": "A",
              "polarity": "passive",
              "node": "in"
            },
            {
              "id": "b",
              "name": "B",
              "polarity": "passive",
              "node": "g1"
            }
          ]
        },
        {
          "id": "MPL",
          "name": "Weak p-channel pull-up",
          "kind": "mosfet",
          "value": 1e-05,
          "channel": "p",
          "thresholdVoltage": 1,
          "channelLengthModulation": 0.02,
          "gateSourceCapacitance": 2.5e-13,
          "gateDrainCapacitance": 2e-14,
          "drainSourceCapacitance": 1e-12,
          "terminals": [
            {
              "id": "drain",
