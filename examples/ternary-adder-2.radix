    {
      "id": "std.bt-latch",
      "name": "Balanced ternary D latch",
      "description": "Level-sensitive trit latch on the balanced -/0/\u002B domain. E=\u002B captures D, E=- holds, and E=0 gives the unknown middle value. The structure is the same Kleene latch used for 0/1/2, wired from balanced gates; Q/QN power up at 0/0, the self-complementary middle value.",
      "pins": [
        {
          "id": "d",
          "name": "D",
          "direction": "input",
          "domain": "balanced-ternary"
        },
        {
          "id": "e",
          "name": "E",
          "direction": "input",
          "domain": "balanced-ternary"
        },
        {
          "id": "q",
          "name": "Q",
          "direction": "output",
          "domain": "balanced-ternary"
        },
        {
          "id": "qn",
          "name": "QN",
          "direction": "output",
          "domain": "balanced-ternary"
        }
      ],
      "instances": [
