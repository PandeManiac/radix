          "label": "D and E",
          "pins": [
            {
              "instance": "capture",
              "pin": "y"
            },
            {
              "instance": "nand_set",
              "pin": "a"
            }
          ]
        },
        {
          "id": "reset_in",
          "domain": "balanced-ternary",
          "label": "not D and E",
          "pins": [
            {
              "instance": "release",
              "pin": "y"
            },
            {
              "instance": "nand_reset",
