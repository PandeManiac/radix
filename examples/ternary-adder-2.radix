          "pins": [
            {
              "instance": "inv",
              "pin": "a"
            },
            {
              "instance": "slave",
              "pin": "e"
            }
          ]
        },
        {
          "id": "q_net",
          "domain": "balanced-ternary",
          "initial": 1,
          "pins": [
