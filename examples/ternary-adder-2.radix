    {
      "id": "std.bt-dff",
      "name": "Balanced ternary D flip-flop",
      "description": "Positive-edge-triggered balanced-ternary flip-flop built from two balanced latches and a complement gate. Drive CLK between - and \u002B; the slave captures on \u002B. Q/QN power up at 0/0.",
      "pins": [
        {
          "id": "d",
          "name": "D",
          "direction": "input",
          "domain": "balanced-ternary"
        },
        {
          "id": "clk",
