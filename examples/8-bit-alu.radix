    {
      "id": "std.t-dff",
      "name": "Ternary D flip-flop",
      "description": "Positive-edge-triggered trit flip-flop built from two ternary latches and an inverter. Drive CLK between 0 and 2; the slave captures on 2. Q/QN power up at 0/2.",
