  "electricalCircuits": [
    {
      "id": "ternary-buffered",
      "name": "Buffered ternary inverter",
      "description": "Two dual-threshold CMOS inverters drive complementary CMOS inverters; the four resulting outputs are summed through 100 kOhm resistors. A two-stage CMOS feedback amplifier buffers the summed node. The pre-summing complements preserve the middle plateau while restoring inverter polarity. The output stage is asymmetric: the p-channel source device is 10x the n-channel sink, so the high level can drive a ground-referenced load while the n-channel sets the mid-state quiescent current.",
      "ground": "gnd",
      "nodes": [
        {
          "id": "gnd",
          "name": "gnd"
        },
