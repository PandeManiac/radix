    {
      "id": "std.dff",
      "name": "D flip-flop",
      "description": "Positive-edge-triggered D flip-flop built from two gated D latches (master/slave) and an inverter. Requires a driven clock; Q/QN power up at 0/1.",
      "pins": [
        {
          "id": "d",
          "name": "D",
          "direction": "input",
          "domain": "binary"
        },
        {
          "id": "clk",
          "name": "CLK",
          "direction": "input",
          "domain": "binary"
        },
        {
          "id": "q",
          "name": "Q",
          "direction": "output",
          "domain": "binary"
        },
        {
          "id": "qn",
          "name": "QN",
          "direction": "output",
          "domain": "binary"
        }
      ],
      "instances": [
        {
          "id": "inv",
          "definition": "std.not",
          "x": 80,
          "y": 40
        },
        {
          "id": "master",
          "definition": "std.d-latch",
          "x": 340,
          "y": 40
        },
        {
          "id": "slave",
          "definition": "std.d-latch",
          "x": 600,
          "y": 160
        }
      ],
      "nets": [
        {
          "id": "d_net",
          "domain": "binary",
          "pins": [
            {
              "instance": "master",
              "pin": "d"
            }
          ]
        },
        {
          "id": "clk_net",
          "domain": "binary",
          "pins": [
            {
              "instance": "inv",
              "pin": "a"
            },
            {
              "instance": "slave",
              "pin": "e"
            }
          ]
        },
        {
          "id": "q_net",
          "domain": "binary",
          "initial": 0,
          "pins": [
            {
              "instance": "slave",
              "pin": "q"
            }
          ]
        },
        {
          "id": "qn_net",
          "domain": "binary",
          "initial": 1,
          "pins": [
            {
              "instance": "slave",
              "pin": "qn"
            }
          ]
        },
        {
          "id": "clk_n",
          "domain": "binary",
          "pins": [
            {
              "instance": "inv",
              "pin": "y"
            },
            {
              "instance": "master",
              "pin": "e"
            }
          ]
        },
        {
          "id": "master_q",
