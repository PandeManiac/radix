          "initial": 0,
          "pins": [
            {
              "instance": "master",
              "pin": "q"
            },
            {
              "instance": "slave",
              "pin": "d"
            }
          ]
        },
        {
          "id": "master_qn",
          "domain": "binary",
          "initial": 1,
          "pins": [
            {
              "instance": "master",
              "pin": "qn"
            }
          ]
        }
      ],
      "ports": [
