      <SolidColorBrush x:Key="App.CanvasGrid" Color="#1E2832" />
      <SolidColorBrush x:Key="App.ComponentFill" Color="#18212B" />
      <SolidColorBrush x:Key="App.ComponentHeader" Color="#222E3A" />
      <SolidColorBrush x:Key="App.ComponentBorder" Color="#4B5E70" />
      <SolidColorBrush x:Key="App.PortFill" Color="#1D2A36" />
      <SolidColorBrush x:Key="App.PinFill" Color="#9AAABC" />
      <SolidColorBrush x:Key="App.PinBadgeBackground" Color="#121A22" />
      <SolidColorBrush x:Key="App.WireLabelBackground" Color="#1A242E" />
      <SolidColorBrush x:Key="App.ZoomBadgeBackground" Color="#1D2833" />
      <SolidColorBrush x:Key="App.TooltipBackground" Color="#E6EDF3" />
      <SolidColorBrush x:Key="App.TooltipText" Color="#0D1319" />
      <SolidColorBrush x:Key="App.SignalLow" Color="#8798A8" />
      <SolidColorBrush x:Key="App.SignalHigh" Color="#3DDC97" />
      <SolidColorBrush x:Key="App.SignalOne" Color="#6AB0F3" />
      <SolidColorBrush x:Key="App.SignalTwo" Color="#F2A94B" />
      <SolidColorBrush x:Key="App.SignalThree" Color="#B69DF8" />
      <SolidColorBrush x:Key="App.SignalFour" Color="#F27FB4" />
      <SolidColorBrush x:Key="App.SignalUndriven" Color="#5D6C7A" />
      <SolidColorBrush x:Key="App.HudBackground" Color="#16202AEE" />
      <SolidColorBrush x:Key="App.HudBorder" Color="#2F3E4C" />
      <SolidColorBrush x:Key="App.CanvasHintBackground" Color="#121A22EA" />
      <SolidColorBrush x:Key="App.CanvasHintBorder" Color="#2A3743" />
      <SolidColorBrush x:Key="App.WavePanel" Color="#101820" />
      <SolidColorBrush x:Key="App.WaveGrid" Color="#26323E" />
      <SolidColorBrush x:Key="App.WaveRowAlt" Color="#161F28" />
      <SolidColorBrush x:Key="App.DiagnosticError" Color="#FF9A90" />
      <SolidColorBrush x:Key="App.DiagnosticWarning" Color="#FFD27A" />
      <SolidColorBrush x:Key="App.DiagnosticInfo" Color="#B9C7D4" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
