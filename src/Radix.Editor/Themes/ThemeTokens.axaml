      <SolidColorBrush x:Key="App.BorderStrong" Color="#34424F" />
      <SolidColorBrush x:Key="App.TextPrimary" Color="#E6EDF3" />
      <SolidColorBrush x:Key="App.TextSecondary" Color="#B9C7D4" />
      <SolidColorBrush x:Key="App.TextMuted" Color="#8294A5" />
      <SolidColorBrush x:Key="App.Accent" Color="#6AB0F3" />
      <SolidColorBrush x:Key="App.AccentSoft" Color="#1C3A55" />
      <SolidColorBrush x:Key="App.AccentText" Color="#0B1117" />
      <SolidColorBrush x:Key="App.SuccessBackground" Color="#153026" />
